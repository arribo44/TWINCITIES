# Copy this file to .env and fill in the values. Never commit .env.

# Back-office credentials. The back office stays disabled while ADMIN_PASSWORD is empty.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Secret used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If empty, a random key is generated at startup and sessions are lost on restart.
FLASK_SECRET=

# Development options
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
